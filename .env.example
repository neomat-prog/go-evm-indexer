# insert your desired RPC_URL eg. alchemy
ETH_RPC_URL=
DB_URL=

# optional: blocks per eth_getLogs call. Providers cap this and reject wider
# ranges — Alchemy's free tier allows 10, which is the default when unset.
ETH_CHUNK_SIZE=

# optional: HTTP listen address, defaults to :8080
LISTEN_ADDR=

# optional: ERC-20 to index, defaults to USDC
TOKEN_ADDR=

# optional: wait between head polls once caught up, defaults to 12s
INTERVAL=

# optional: blocks behind head to start at on first run, defaults to 100
LOOKBACK=
